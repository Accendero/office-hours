# Copy to .env before `make up`.  Laptop-only credentials -- on AWS these are DELETED,
# not migrated: the compute gets an IAM role instead. See docs/AWS.md.
S3_ACCESS_KEY=lakehouse
S3_SECRET_KEY=lakehouse-local-secret
S3_BUCKET=lakehouse
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1

POSTGRES_PASSWORD=mlflow-local-secret

# Trino heap. Set via JAVA_TOOL_OPTIONS so we don't replace Trino's own tuned jvm.config.
# Drop to -Xmx1500m on an 8 GB machine.
TRINO_HEAP=-Xmx2g
